  goalSummary: "\u6BD2\u306E\u529B\u304C\u5F37\u3044\u6DB2\u4F53\uFF08\u6BD2 25 \u4EE5\u4E0A\u30FB\u6BD2\u304C\u3044\u3061\u3070\u3093\u5F37\u3044\uFF09"
